<?xml version="1.0" encoding="utf-8"?>
<!-- Ícone adaptativo: fundo branco liso, o alvo da marca no primeiro plano.
     Branco de propósito — é sobre branco que a marca foi desenhada, e é o
     que faz o vermelho do alvo saltar na grade do launcher. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ls_icone_fundo" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monocromatico" />
</adaptive-icon>
