<?xml version="1.0" encoding="utf-8"?>
<!-- Ícone adaptativo. O fundo é um gradiente azul-noite e o primeiro
     plano é só o símbolo: alvo com o dardo cravado, sem o nome escrito e
     sem a pílula branca.

     Antes aqui entrava a logotipia inteira sobre branco. Numa tela de
     48dp o nome vira borrão, a assinatura some e o que sobra é um
     retângulo branco com sujeira no meio -- e ainda por cima o manifesto
     nem chegava a usar este arquivo, apontava direto para o PNG.

     A arte cabe inteira no círculo seguro de 36 de raio: nenhuma máscara
     de launcher corta o dardo. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ls_icone_fundo" />
    <foreground android:drawable="@drawable/ls_marca_simbolo" />
    <monochrome android:drawable="@drawable/ls_marca_mono" />
</adaptive-icon>
