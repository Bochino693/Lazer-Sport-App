<?xml version="1.0" encoding="utf-8"?>
<!-- NÃO existe values-night. O app tem um visual só, escuro, desenhado
     pelo Compose; o tema da plataforma serve apenas para a janela nascer
     na cor certa.

     Havia um values-night que declarava Theme.LazerSport_APP herdando
     direto de Theme.Material3.Light.NoActionBar, e não do Base daqui. Com
     isso, no celular em modo escuro, o tema perdia windowBackground E o
     windowSplashScreenBackground do values-v31 — o modo noturno tem
     precedência sobre o qualificador de versão, então o arquivo night
     ganhava dos dois. Resultado: quem usa o telefone no escuro via um
     flash branco antes da abertura. -->
<resources>
    <style name="Base.Theme.LazerSport_APP" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ls_azul</item>
        <item name="colorSecondary">@color/ls_azul_escuro</item>
        <item name="colorTertiary">@color/ls_vermelho</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>

        <!-- A janela nasce na cor em que a abertura começa. O tema é Light
             (o app inteiro é claro), então sem isto o Android pintaria
             branco até o Compose desenhar, e a cut scene escura entraria
             depois de um flash branco. -->
        <item name="android:windowBackground">@color/ls_abertura_fundo</item>
    </style>

    <style name="Theme.LazerSport_APP" parent="Base.Theme.LazerSport_APP" />
</resources>